#!/usr/bin/ruby

require 'yaml'
require 'fstui'
require 'bofomatic'

CFG = YAML.load(File.read("bofomatic-cli.yaml"))

module BomCli
  class MainMenu
    def initialize(screen:, no_exit: false)
      @screen = screen
      @main_menu = @screen.new_menu("Welcome to the BoF-O-Matic System!")
      @main_menu.add_item :proposals, "View Session Proposals"
      @main_menu.add_item :propose, "Propose a BoF"
      #@main_menu.add_item :login, "Scheduler Login"
      @main_menu.add_item :exit,  "Exit" unless no_exit
    end
    
    def present
      @screen.titlebar.center = "BoF-O-Matic"
      date_string = Time.now.strftime("%d %^b %Y")
      time_string = Time.now.strftime("%H:%M")
      @screen.titlebar.left = date_string
      @screen.titlebar.right = time_string
      
      loop do
        response = @main_menu.get_response
        case response
          when :exit
            @screen.destroy
            Kernel.exit
          else
            return response
        end
      end
    end
  end

  class ProposalsView
    def initialize(screen:, url:, key:)
      @screen = screen
      @bom_api = BofOMatic::ApiV1.new(url: url, apikey: key)
      
      @infolist = @screen.new_infolist("Filter: none applied", 2)
      @infolist.left_heading = "Session Details"
      @infolist.right_heading = "Scheduling Status"
    end
    
    def present
      @screen.titlebar.center = "BoF-O-Matic - Session Proposals"
      #@screen.inputbar.instructions = "M=Main Menu"
      @infolist.clear_items
      @bom_api.proposals.each do |proposal|
        schedule_line1 = "Not Scheduled"
        schedule_line2 = ""
        if(proposal.scheduled) then
          schedule_line1 = proposal.start_time.strftime("%A %H:%M")
          schedule_line2 = proposal.room
        end
        @infolist.add_item FSTui::InfoItem.new(key: proposal.id, rows: [
          FSTui::InfoRow.new(lhs: proposal.title, rhs: schedule_line1),
          FSTui::InfoRow.new(lhs: proposal.description, rhs: schedule_line2)
        ])
      end
      date_string = Time.now.strftime("%d %^b %Y")
      time_string = Time.now.strftime("%H:%M")
      @screen.titlebar.left = date_string
      @screen.titlebar.right = time_string
      @screen.redraw
      
      @infolist.get_response(extra_options: {'M' => 'Main Menu'})
    end
  end
  
  class ProposalDetailView
    def initialize(screen:, url:, key:)
      @screen = screen
      @bom_api = BofOMatic::ApiV1.new(url: url, apikey: key)
      
      @datascreen = @screen.new_datascreen("Title", "Subtitle", "Details go here\nalso here\neven here, too\nand here!")
    end
    
    def present(proposal_id)
      proposal = @bom_api.proposals[proposal_id]

      @screen.titlebar.center = "BoF-O-Matic - Session Details"
      @screen.inputbar.instructions = "I=Express Interest  B=Back  M=Main Menu"
      date_string = Time.now.strftime("%d %^b %Y")
      time_string = Time.now.strftime("%H:%M")
      @screen.titlebar.left = date_string
      @screen.titlebar.right = time_string
      @screen.redraw

      @datascreen.title = proposal.title
      @datascreen.subtitle = proposal.description
      interests = ["Interested:"]
      proposal.interests.each do |data|
        interests << "- #{data.name}"
      end
      proposer_info = "Proposed by #{proposal.submitted_by}"
      schedule_info = "Status: Gathering Interest"
      schedule_info = "Scheduled for #{proposal.start_time.strftime("%A %H:%M")} in #{proposal.room}" if proposal.scheduled
      @datascreen.data = proposer_info + "\n" + schedule_info + "\n\n" + interests.join("\n")

      @datascreen.get_response options: ['i', 'b', 'm']
    end
  end

  class ProposalInterestView
    def initialize(screen:, url:, key:)
      @screen = screen
      @bom_api = BofOMatic::ApiV1.new(url: url, apikey: key)
      
      @fieldscreen = @screen.new_fieldscreen("BoF-O-Matic - Express Interest", "Subtitle", "Details go here\nalso here\neven here, too\nand here!")
      @fieldscreen = @screen.new_fieldscreen "BoF-O-Matic", "Express Interest", [
        FSTui::Field.new(name: "Name"),
        FSTui::Field.new(name: "Email", required: false),
        FSTui::Field.new(name: "Phone", required: false)
      ]
    end
    
    def present(proposal_id)
      @fieldscreen.clear_fields
      proposal = @bom_api.proposals[proposal_id]

      @screen.titlebar.center = "BoF-O-Matic - Express Interest"
      #date_string = Time.now.strftime("%d %^b %Y")
      #time_string = Time.now.strftime("%H:%M")
      #@screen.titlebar.left = date_string
      #@screen.titlebar.right = time_string
      @screen.redraw

      @fieldscreen.title = "Express Interest"
      @fieldscreen.subtitle = "'#{proposal.title}'"
      
      fields = @fieldscreen.get_response
      return if fields == nil
      # TODO: clean this up
      name = email = phone = nil
      fields.each do |field|
        name  = field.value if field.name == 'Name'
        email = field.value if field.name == 'Email'
        phone = field.value if field.name == 'Phone'
      end
      proposal.add_interest name: name, email: email, phone: phone
    end
  end
  
  class ProposeNewView
    def initialize(screen:, url:, key:)
      @screen = screen
      @bom_api = BofOMatic::ApiV1.new(url: url, apikey: key)
      
      @fieldscreen = @screen.new_fieldscreen "BoF-O-Matic", "Propose New Session", [
        FSTui::Field.new(name: "Your Name"),
        FSTui::Field.new(name: "Email"),
        FSTui::Field.new(name: "Phone", required: false),
        FSTui::Field.new(name: "Session Title"),
        FSTui::Field.new(name: "Description"),
        FSTui::Field.new(name: "Notes for Scheduler", required: false)
      ]
    end
    
    def present
      @fieldscreen.clear_fields
      # just check to make sure we can access the server
      # if we can't, better to bail out now than have them fill in a bunch of info
      @bom_api.proposals[0]
      #date_string = Time.now.strftime("%d %^b %Y")
      #time_string = Time.now.strftime("%H:%M")
      #@screen.titlebar.left = date_string
      #@screen.titlebar.right = time_string
      @screen.redraw

      #@fieldscreen.title = "Propose Session"
      #@fieldscreen.subtitle = "'#{proposal.title}'"
      
      fields = @fieldscreen.get_response
      return if fields == nil
      # TODO: clean this up
      submitted_by = submitter_email = submitter_phone = session_title = session_description = scheduler_notes = nil
      fields.each do |field|
        submitted_by = field.value        if field.name == 'Your Name'
        submitter_email = field.value     if field.name == 'Email'
        submitter_phone = field.value     if field.name == 'Phone'
        session_title = field.value       if field.name == 'Session Title'
        session_description = field.value if field.name == 'Description'
        scheduler_notes = field.value     if field.name == 'Notes for Scheduler'
      end
      @bom_api.proposals.new submitted_by: submitted_by, submitter_email: submitter_email, submitter_phone: submitter_phone, session_title: session_title, session_description: session_description, scheduler_notes: scheduler_notes
    end
  end
end

begin
  screen = FSTui::Screen.new
  main_menu = BomCli::MainMenu.new(screen: screen, no_exit: CFG['no_exit'])
  proposals = BomCli::ProposalsView.new(screen: screen, url: CFG['api_url'], key: CFG['api_key'])
  proposal_details = BomCli::ProposalDetailView.new(screen: screen, url: CFG['api_url'], key: CFG['api_key'])
  proposal_interest = BomCli::ProposalInterestView.new(screen: screen, url: CFG['api_url'], key: CFG['api_key'])
  propose_new = BomCli::ProposeNewView.new(screen: screen, url: CFG['api_url'], key: CFG['api_key'])

  while true do
    case main_menu.present
      when :proposals
        loop do
          proposal_id = proposals.present
          break if proposal_id == 'm' or proposal_id == 'M'
          selected_option = proposal_details.present(proposal_id)
          break if selected_option.downcase == 'm'
          if(selected_option.downcase == 'i') then
            # they want to express interest in the session
            proposal_interest.present(proposal_id)
          end
        end
      when :propose
        propose_new.present
    end
  end
rescue Errno::ECONNREFUSED => e
  screen.pop_messagebox("Network Error", "Connection was refused trying to reach #{CFG['api_url']}, please try later.")
  retry
rescue Socket::ResolutionError => e
  screen.pop_messagebox("Network Error", "Unable to resolve #{CFG['api_url']}, check configuration.")
  retry
rescue RestClient::Unauthorized => e
  screen.pop_messagebox("Auth Error", "API key is invalid or revoked, check configuration.")
  retry
rescue RestClient::ServiceUnavailable => e
  screen.pop_messagebox("Service Unavailable", "Backend service unavailable (503), please try later.")
  retry
rescue Interrupt => e
  if(!CFG['no_exit']) then
    screen.destroy
    Kernel.exit 0
  end

  screen.pop_messagebox("No Exit", "Exit has been disabled by the administrator.")
  retry
ensure
  screen.destroy
end

